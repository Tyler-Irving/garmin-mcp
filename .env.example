# Copy this file to .env for local development.
# On Cloud Run, set these as environment variables on the service instead.

# Public HTTPS URL of this server (no trailing slash). For Cloud Run this is
# the URL gcloud prints after deploy, e.g. https://garmin-mcp-xxx.a.run.app
MCP_ISSUER_URL=http://localhost:8080

# Password Claude.ai prompts you for during the OAuth flow. Pick something long.
MCP_AUTH_PASSWORD=CHANGE_ME

# Used to sign JWT access tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Your Garmin Connect login.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=CHANGE_ME

# Where Garmin OAuth tokens are persisted. /tmp is writable on Cloud Run.
GARMIN_TOKEN_DIR=/tmp/garth

# HTTP bind. Cloud Run sets PORT automatically; HOST should stay 0.0.0.0.
HOST=0.0.0.0
PORT=8080
